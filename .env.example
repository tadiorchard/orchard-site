# Salesforce — powers the /jobs listings.
#
# Server-only. Every value here is read inside server handlers and never
# reaches the browser. Copy to .env.local for local dev, and add the same
# values to the Vercel project for production.
#
# Auth is the JWT Bearer flow. In Salesforce the Connected App needs:
#   - "Use digital signatures" with your certificate uploaded
#   - OAuth scopes: api, refresh_token
#   - the running user pre-authorised (Manage Profiles / Permission Sets), and
#     "Admin approved users are pre-authorized" set on the policy
#   - read access to the job object for that user's profile

SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=your-connected-app-consumer-key
SALESFORCE_USERNAME=api-user@yourorg.com

# The PEM private key matching the certificate on the Connected App.
# On Vercel: paste the whole key as one value (literal \n between lines is fine).
SALESFORCE_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Local dev alternative — a path to the .key file. Ignored if the key above is
# set, and useless once deployed, so prefer the env var.
# SALESFORCE_JWT_PRIVATE_KEY_PATH=/absolute/path/to/salesforce.key

# Object API name for job records. Defaults to nuProducts__Jobs__c.
# SALESFORCE_JOB_OBJECT=nuProducts__Job__c

# reCAPTCHA v2 secret, paired with the site key already in the forms. Required
# for the job application form: without it every submission is refused, since
# an unverified public endpoint that creates Salesforce Contacts is exactly
# what spam bots look for. Until it is set, job pages show the contact route
# instead of the form.
RECAPTCHA_SECRET_KEY=your-recaptcha-v2-secret

# reCAPTCHA v2 SITE key — public, ships in the HTML. Keys are locked to a
# domain list, so a preview host and the live domain need either separate keys
# or one key with both domains registered. Omit to fall back to the key
# registered for orchardcorp.com. Must be the pair of RECAPTCHA_SECRET_KEY.
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-v2-site-key

# Public origin used for canonical URLs, og:url, JSON-LD and the sitemap.
# Set this to the live domain (e.g. https://www.orchardcorp.com) when the site
# moves off the deploy URL — every SEO tag reads from it.
VITE_SITE_URL=https://orchard-site-xi.vercel.app
